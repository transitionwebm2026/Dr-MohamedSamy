# Hostinger (Apache) config for the static export in /out.
# next.config.js can't set headers()/redirects() under output:'export',
# so this is the equivalent for a plain static host.

# Force HTTPS
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Consolidate www / non-www onto ONE canonical host — pick the version that
# matches your actual domain setup, uncomment it, and delete the other.
# Using both at once, or the wrong one, will redirect-loop the site.
#
# --- Option A: force the bare domain (dr-mohamedsamy.com) ---
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^(.*)$ https://%1/$1 [L,R=301]
#
# --- Option B: force the www subdomain (www.dr-mohamedsamy.com) ---
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [L,R=301]

# Security headers
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# The site exports with trailingSlash:true (folder/index.html), which
# Apache's default DirectoryIndex already serves correctly — no rewrite
# needed for that part.

ErrorDocument 404 /404.html

# Cache hashed Next.js build assets aggressively; everything else (HTML) not at all.
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|gif|svg|ico|webp|avif)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
  </FilesMatch>
</IfModule>
